BOT_TOKEN=your_telegram_bot_token_here

# Telegram ID администраторов через запятую
# ADMIN_IDS=123456789

# Прокси (оставьте пустым, если не нужен)
PROXY=

# Примеры:
# PROXY=socks5://127.0.0.1:1080
# PROXY=http://user:pass@host:8080

# Проверять прокси при запуске бота (true/false)
PROXY_CHECK=true

# Куда проверять доступ (по умолчанию Telegram API)
# PROXY_CHECK_URL=https://api.telegram.org

# Таймаут проверки в секундах
# PROXY_TIMEOUT=15
